{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=SmsGateway;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Admin": {
    "Key": "CHANGE-ME-admin-key-9f8e7d6c"
  },

  "Seed": {
    "ClientName": "Finocore",
    "ClientApiKey": "sk_finocore_CHANGE_ME_1a2b3c4d5e6f",
    "DeviceName": "Phone-1",
    "DeviceKey": "dk_phone1_CHANGE_ME_a1b2c3d4e5f6"
  },

  "Gateway": {
    "DefaultCountryCode": "+91",
    "DefaultMaxAttempts": 3,
    "RetryBaseSeconds": 30,
    "StaleAssignmentMinutes": 3,
    "MessageExpiryHours": 24,
    "DevicePollIntervalSeconds": 5,
    "DeviceMaxBatch": 5,
    "DeviceOfflineAfterSeconds": 120,
    "MaintenanceIntervalSeconds": 30,
    "TimeZone": "India Standard Time",
    "WebhookRetries": 3,
    "WebhookTimeoutSeconds": 10
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/smsgateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
